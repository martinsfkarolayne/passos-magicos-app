      "source": [
        "def imput_IPP(df_comum_por_ano):\n",
        "    # import pandas as pd\n",
        "    # import numpy as np\n",
        "    from sklearn.impute import KNNImputer\n",
        "\n",
        "    # ============================================================\n",
        "    # 0. Cópia de segurança para não modificar o original\n",
        "    # ============================================================\n",
        "    df = df_comum_por_ano.copy()\n",
        "\n",
        "    # ============================================================\n",
        "    # 1. Verificação dos campos necessários\n",
        "    # ============================================================\n",
        "    colunas_necessarias = ['INDE_ano_atual', 'IAN', 'IDA', 'IEG', 'IAA', 'IPS', 'IPV']\n",
        "    faltantes = [c for c in colunas_necessarias if c not in df.columns]\n",
        "\n",
        "    if faltantes:\n",
        "        print(f\"❌ Atenção: Faltam as colunas: {faltantes}\")\n",
        "    else:\n",
        "        print(\"✅ Todas as colunas necessárias estão presentes.\")\n",
        "\n",
        "    # ============================================================\n",
        "    # 2. Cálculo reverso para Fases 0 a 7 (ANO 2022)\n",
        "    # ============================================================\n",
        "    # Máscara: ano 2022, IPP nulo, e Fase_Ideal_1 diferente de 'Fase 8'\n",
        "    mask_fases_0_7 = (\n",
        "        (df['ano'] == 2022) &\n",
        "        (df['IPP'].isna()) &\n",
        "        (df['Fase_Ideal_1'] != 'Fase 8')\n",
        "    )\n",
        "\n",
        "    # Cálculo da parte da fórmula sem o IPP\n",
        "    parte_sem_ipp = (\n",
        "        df.loc[mask_fases_0_7, 'IAN'] * 0.1 +\n",
        "        df.loc[mask_fases_0_7, 'IDA'] * 0.2 +\n",
        "        df.loc[mask_fases_0_7, 'IEG'] * 0.2 +\n",
        "        df.loc[mask_fases_0_7, 'IAA'] * 0.1 +\n",
        "        df.loc[mask_fases_0_7, 'IPS'] * 0.1 +\n",
        "        df.loc[mask_fases_0_7, 'IPV'] * 0.2\n",
        "    )\n",
        "\n",
        "    # Isolando o IPP\n",
        "    df.loc[mask_fases_0_7, 'IPP'] = (\n",
        "        df.loc[mask_fases_0_7, 'INDE_ano_atual'] - parte_sem_ipp\n",
        "    ) / 0.1\n",
        "\n",
        "    # Opcional: Clipar valores para o intervalo padrão (ex: 0 a 10)\n",
        "    df.loc[mask_fases_0_7, 'IPP'] = df.loc[mask_fases_0_7, 'IPP'].clip(0, 10)\n",
        "\n",
        "    print(f\"✅ IPP calculado para {mask_fases_0_7.sum()} registros das Fases 0 a 7.\")\n",
        "\n",
        "    # ============================================================\n",
        "    # 3. Imputação KNN para a Fase 8 (ANO 2022)\n",
        "    # ============================================================\n",
        "    # Isolar apenas a Fase 8\n",
        "    mask_fase8 = df['Fase_Ideal_1'] == 'Fase 8'\n",
        "    df_fase8 = df[mask_fase8].copy()\n",
        "\n",
        "    # Selecionar features numéricas para o KNN\n",
        "    features_knn = ['IAN', 'IDA', 'IEG', 'IAA', 'IPS', 'IPV', 'INDE_ano_atual', 'IPP']\n",
        "\n",
        "    # Verificar se há nulos nas features (exceto IPP) para a Fase 8\n",
        "    nulos_features = df_fase8[features_knn].isna().sum()\n",
        "    if nulos_features.sum() > 0:\n",
        "        print(\"⚠️ Atenção: Existem valores nulos em outras features da Fase 8.\")\n",
        "        print(nulos_features[nulos_features > 0])\n",
        "\n",
        "    # Aplicar KNN Imputer\n",
        "    # n_neighbors=5 é um padrão razoável, mas pode ser ajustado\n",
        "    imputer = KNNImputer(n_neighbors=5)\n",
        "    df_fase8[features_knn] = imputer.fit_transform(df_fase8[features_knn])\n",
        "\n",
        "    # Atualizar o DataFrame principal com os valores imputados\n",
        "    df.loc[mask_fase8, 'IPP'] = df_fase8['IPP']\n",
        "\n",
        "    print(f\"✅ IPP imputado via KNN para {mask_fase8.sum()} registros da Fase 8.\")\n",
        "\n",
        "    # ============================================================\n",
        "    # 4. Verificação Final\n",
        "    # ============================================================\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"VERIFICAÇÃO FINAL DE NULOS EM 'IPP' POR ANO\")\n",
        "    print(\"=\" * 60)\n",
        "    analise_final = (\n",
        "        df.groupby('ano')['IPP']\n",
        "        .agg(total='size', nulos=lambda s: s.isna().sum())\n",
        "        .assign(perc_nulos=lambda d: d['nulos'] / d['total'] * 100)\n",
        "    )\n",
        "    print(analise_final.to_string())\n",
        "\n",
        "    # Verificar se ainda há nulos em 2022\n",
        "    nulos_2022 = df[(df['ano'] == 2022) & (df['IPP'].isna())]\n",
        "    if nulos_2022.empty:\n",
        "        print(\"\\n🎉 Todos os valores de IPP para 2022 foram preenchidos!\")\n",
        "    else:\n",
        "        print(f\"\\n⚠️ Ainda restam {len(nulos_2022)} valores nulos em 2022.\")\n",
        "\n",
        "    return df\n",
        "\n",
        "df_comum_por_ano = imput_IPP(df_comum_por_ano)\n",
        "analise_IPP(df_comum_por_ano)"
      ]
    },
