    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# SELEÇÃO DE FEATURES E TARGET - MODELO FINAL ESCOLHIDO\n",
        "# ============================================================\n",
        "\n",
        "# Target de risco no ciclo atual: IDA < 6.0 OU IEG < 6.0 OU Pedra Quartzo\n",
        "df_comum_por_ano['Em_Risco_Vigente'] = np.where(\n",
        "    (df_comum_por_ano['IDA'] < 6.0) |\n",
        "    (df_comum_por_ano['IEG'] < 6.0) |\n",
        "    (df_comum_por_ano['pedra_ano_atual'] == 'Quartzo'),\n",
        "    1,\n",
        "    0\n",
        ")\n",
        "\n",
        "# Seleção de colunas limpas para ML (sem IAN para evitar data leakage)\n",
        "colunas_modelo_definitivo = [\n",
        "    'RA', 'ano',\n",
        "    'Fase', 'Gênero', 'Instituição de ensino',\n",
        "    'IDA', 'IEG', 'IAA', 'IPS', 'IPP', 'IPV', 'Mat', 'Por',\n",
        "    'Em_Risco_Vigente'\n",
        "]\n",
        "\n",
        "df_ml_definitivo = df_comum_por_ano[colunas_modelo_definitivo].copy()\n",
        "\n",
        "# Separando Matriz de Features (X) e Target (y)\n",
        "X_def = df_ml_definitivo.drop(columns=['RA', 'ano', 'Em_Risco_Vigente'])\n",
        "y_def = df_ml_definitivo['Em_Risco_Vigente']\n",
        "\n",
        "# Binarização / One-Hot Encoding das colunas categóricas\n",
        "X_def_encoded = pd.get_dummies(X_def, drop_first=True)\n",
        "\n",
        "# Divisão Treino e Teste (80% treino / 20% teste com estratificação)\n",
        "X_train_d, X_test_d, y_train_d, y_test_d = train_test_split(\n",
        "    X_def_encoded, y_def, test_size=0.20, random_state=42, stratify=y_def\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# TREINAMENTO E AVALIAÇÃO DO MODELO ESCOLHIDO (XGBOOST)\n",
        "# ============================================================\n",
        "\n",
        "modelo_xgb = XGBClassifier(n_estimators=100, learning_rate=0.1, random_state=42, eval_metric='logloss')\n",
        "modelo_xgb.fit(X_train_d, y_train_d)\n",
        "\n",
        "y_pred = modelo_xgb.predict(X_test_d)\n",
        "y_proba = modelo_xgb.predict_proba(X_test_d)[:, 1]\n",
        "\n",
        "# Cálculo das Métricas Finais\n",
        "acc = accuracy_score(y_test_d, y_pred)\n",
        "rec = recall_score(y_test_d, y_pred)\n",
        "prec = precision_score(y_test_d, y_pred)\n",
        "f1 = f1_score(y_test_d, y_pred)\n",
        "auc = roc_auc_score(y_test_d, y_proba)\n",
        "\n",
        "df_resultado_final = pd.DataFrame([{\n",
        "    'Modelo': 'XGBoost (Campeão)',\n",
        "    'Acurácia': f\"{acc:.4f} ({acc:.2%})\",\n",
        "    'Recall (Em Risco)': f\"{rec:.4f} ({rec:.2%})\",\n",
        "    'Precisão (Em Risco)': f\"{prec:.4f} ({prec:.2%})\",\n",
        "    'F1-Score': f\"{f1:.4f}\",\n",
        "    'ROC-AUC': f\"{auc:.4f}\"\n",
        "}])\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"MÉTRICAS DEFINITIVAS DE PERFORMANCE — MODELO CAMPEÃO (XGBOOST)\")\n",
        "print(\"=\" * 75)\n",
        "display(df_resultado_final)\n",
        "\n",
        "# ============================================================\n",
        "# MATRIZ DE CONFUSÃO DO XGBOOST\n",
        "# ============================================================\n",
        "\n",
        "cm_xgb = confusion_matrix(y_test_d, y_pred)\n",
        "\n",
        "plt.figure(figsize=(6.5, 4.5))\n",
        "sns.heatmap(cm_xgb, annot=True, fmt='d', cmap='Blues',\n",
        "            xticklabels=['Previsto: Não Risco', 'Previsto: Em Risco'],\n",
        "            yticklabels=['Real: Não Risco', 'Real: Em Risco'])\n",
        "\n",
        "plt.title('Matriz de Confusão Definitiva — XGBoost (Modelo Campeão)', fontsize=12, pad=12, fontweight='bold')\n",
        "plt.ylabel('Classe Real', fontsize=10)\n",
        "plt.xlabel('Classe Predita', fontsize=10)\n",
        "plt.tight_layout()\n",
        "plt.show()"
