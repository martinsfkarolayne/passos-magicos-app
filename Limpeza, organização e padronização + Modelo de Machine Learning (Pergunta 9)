        "import re\n",
        "# import pandas as pd\n",
        "\n",
        "# Função que conta por categoria e ano\n",
        "def cont_por_categoria_e_ano(df, category_col, year_col='ano'):\n",
        "    return df[[category_col, year_col]].value_counts().sort_index()\n",
        "\n",
        "# Função auxiliar para limpar o nome da coluna e torná-lo um identificador Python válido\n",
        "def sanitize_name(name):\n",
        "    # Substitui qualquer caractere que NÃO seja letra, número ou underscore por '_'\n",
        "    clean = re.sub(r'[^a-zA-Z0-9_]', '_', name)\n",
        "    # Remove underscores repetidos\n",
        "    clean = re.sub(r'_+', '_', clean)\n",
        "    # Remove underscore do início ou fim\n",
        "    clean = clean.strip('_')\n",
        "    # Se ficar vazio, usa 'var'\n",
        "    if not clean:\n",
        "        clean = 'var'\n",
        "    return clean\n",
        "\n",
        "# DataFrame de exemplo (substitua pelo seu)\n",
        "df = df_comum_por_ano\n",
        "year_col = 'ano'\n",
        "\n",
        "# --- FILTRO: apenas colunas com dtype 'object' (excluindo a coluna de ano) ---\n",
        "cols = [c for c in df.columns if df[c].dtype == 'object' and c != year_col]\n",
        "\n",
        "# Dicionário para armazenar os resultados (opcional)\n",
        "resultados = {}\n",
        "relatorio = []\n",
        "\n",
        "for col in cols:\n",
        "    # Gera um nome de variável válido\n",
        "    nome_limpo = sanitize_name(col)\n",
        "    nome_variavel = 'resultado_' + nome_limpo\n",
        "\n",
        "    # Aplica a função\n",
        "    serie = cont_por_categoria_e_ano(df, col, year_col)\n",
        "\n",
        "    # Cria a variável no escopo global (acessível diretamente no notebook)\n",
        "    globals()[nome_variavel] = serie\n",
        "\n",
        "    # Guarda referência no dicionário\n",
        "    resultados[col] = serie\n",
        "\n",
        "    relatorio.append({\n",
        "        'Coluna de origem': col,\n",
        "        'Variável criada': nome_variavel,\n",
        "        'Tamanho (linhas)': len(serie)\n",
        "    })\n",
        "\n",
        "# Cria um DataFrame com o relatório\n",
        "relatorio_df = pd.DataFrame(relatorio)\n",
        "print(\"Relatório de variáveis criadas (apenas colunas 'object'):\")\n",
        "display(relatorio_df)   # no Jupyter\n",
        "# ou print(relatorio_df) em script"
      ]
