        "def analise_IPP(df_comum_por_ano):\n",
        "    # import pandas as pd\n",
        "\n",
        "    # ============================================================\n",
        "    # 1. Definição dos campos necessários e filtro do ano\n",
        "    # ============================================================\n",
        "    # Campos necessários para o cálculo reverso do IPP (Fases 0 a 7)\n",
        "    colunas_analise = ['INDE_ano_atual', 'IAN', 'IDA', 'IEG', 'IAA', 'IPS', 'IPV', 'IPP']\n",
        "\n",
        "    # Filtrar apenas o ano de 2022 (onde o IPP está nulo)\n",
        "    df_2022 = df_comum_por_ano[df_comum_por_ano['ano'] == 2022].copy()\n",
        "\n",
        "    # Ordem lógica das fases para exibição\n",
        "    ordem_fases = ['ALFA', 'Fase 1', 'Fase 2', 'Fase 3', 'Fase 4', 'Fase 5', 'Fase 6', 'Fase 7', 'Fase 8']\n",
        "\n",
        "    # ============================================================\n",
        "    # 2. Contagem de valores NÃO NULOS por Fase\n",
        "    # ============================================================\n",
        "    # Agrupa por fase e conta quantos valores não nulos existem em cada campo\n",
        "    df_nao_nulos = df_2022.groupby('Fase_Ideal_1')[colunas_analise].count()\n",
        "    df_nao_nulos = df_nao_nulos.reindex(ordem_fases) # Reordena as fases\n",
        "\n",
        "    # Adiciona o total de registros por fase para referência\n",
        "    total_por_fase = df_2022.groupby('Fase_Ideal_1').size().reindex(ordem_fases)\n",
        "    df_nao_nulos['Total_Registros'] = total_por_fase\n",
        "\n",
        "    print(\"=\" * 70)\n",
        "    print(\"CONTAGEM DE VALORES NÃO NULOS POR FASE (ANO 2022)\")\n",
        "    print(\"=\" * 70)\n",
        "    print(df_nao_nulos.to_string())\n",
        "\n",
        "    # ============================================================\n",
        "    # 3. Percentual de Preenchimento por Fase\n",
        "    # ============================================================\n",
        "    # Calcula a porcentagem de preenchimento de cada campo em relação ao total da fase\n",
        "    df_perc = df_nao_nulos[colunas_analise].div(df_nao_nulos['Total_Registros'], axis=0) * 100\n",
        "    df_perc = df_perc.round(2) # Arredonda para 2 casas decimais\n",
        "    df_perc['Total_Registros'] = df_nao_nulos['Total_Registros']\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"PERCENTUAL DE PREENCHIMENTO (%) POR FASE (ANO 2022)\")\n",
        "    print(\"=\" * 70)\n",
        "    print(df_perc.to_string())\n",
        "\n",
        "    # ============================================================\n",
        "    # 4. Diagnóstico Automático\n",
        "    # ============================================================\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"DIAGNÓSTICO PARA O CÁLCULO REVERSO\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    # Verifica se há alguma fase (0 a 7) com problemas\n",
        "    fases_calculo = [f for f in ordem_fases if f != 'Fase 8']\n",
        "\n",
        "    for fase in fases_calculo:\n",
        "        if fase in df_perc.index:\n",
        "            # Verifica se todos os campos necessários estão 100% preenchidos\n",
        "            campos_faltando = df_perc.loc[fase, colunas_analise[:-1]] # Exclui o IPP da verificação\n",
        "            if (campos_faltando < 100).any():\n",
        "                print(f\"⚠️ {fase}: Faltam dados em alguns campos. O cálculo reverso pode gerar nulos ou erros.\")\n",
        "                print(f\"   Campos com problemas: {campos_faltando[campos_faltando < 100].to_dict()}\")\n",
        "            else:\n",
        "                print(f\"✅ {fase}: Todos os campos necessários estão 100% preenchidos. Cálculo reverso seguro.\")\n",
        "\n",
        "    # Verifica a Fase 8\n",
        "    if 'Fase 8' in df_perc.index:\n",
        "        print(\"\\n⚠️ Fase 8: Lembre-se de que a fórmula do INDE para esta fase NÃO utiliza o IPP.\")\n",
        "        print(\"   Portanto, o cálculo reverso não é possível. Será necessária imputação (ex: KNN).\")\n",
        "\n",
        "analise_IPP(df_comum_por_ano)"
      ]
