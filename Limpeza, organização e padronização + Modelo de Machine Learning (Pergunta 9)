        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import joblib\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, recall_score, precision_score,\n",
        "    f1_score, roc_auc_score, confusion_matrix\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# CARREGAR O MODELO TREINADO E OS METADADOS DE COLUNAS\n",
        "# ============================================================\n",
        "\n",
        "dados_app = joblib.load('modelo_xgb_passos_magicos.pkl')\n",
        "modelo_xgb_carregado = dados_app['modelo_xgb']\n",
        "colunas_treino = dados_app['colunas_treino']\n",
        "\n",
        "print(\"=\" * 80)\n",
        "print(\"MODELO XGBOOST CARREGADO COM SUCESSO PARA O TESTE DA BASE DE 2024\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "# ============================================================\n",
        "# PREPARAR OS DADOS DO ANO DE 2024\n",
        "# ============================================================\n",
        "\n",
        "# Filtra apenas os alunos do ano de 2024\n",
        "df_2024 = df_comum_por_ano[df_comum_por_ano['ano'] == 2024].copy()\n",
        "\n",
        "# Garante a criação da Target real do ciclo vigente em 2024 para validação\n",
        "df_2024['Em_Risco_Vigente'] = np.where(\n",
        "    (df_2024['IDA'] < 6.0) |\n",
        "    (df_2024['IEG'] < 6.0) |\n",
        "    (df_2024['pedra_ano_atual'] == 'Quartzo'),\n",
        "    1,\n",
        "    0\n",
        ")\n",
        "\n",
        "# Seleção das colunas de entrada\n",
        "colunas_modelo = [\n",
        "    'RA', 'ano',\n",
        "    'Fase', 'Gênero', 'Instituição de ensino',\n",
        "    'IDA', 'IEG', 'IAA', 'IPS', 'IPP', 'IPV', 'Mat', 'Por',\n",
        "    'Em_Risco_Vigente'\n",
        "]\n",
        "\n",
        "df_2024_ml = df_2024[colunas_modelo].copy()\n",
        "\n",
        "# Separando Features (X_2024) e Target Real (y_2024)\n",
        "X_2024_raw = df_2024_ml.drop(columns=['RA', 'ano', 'Em_Risco_Vigente'])\n",
        "y_2024_real = df_2024_ml['Em_Risco_Vigente']\n",
        "\n",
        "# Binarização (One-Hot Encoding)\n",
        "X_2024_encoded = pd.get_dummies(X_2024_raw).astype(int)\n",
        "\n",
        "# Alinha a estrutura de colunas para ser EXATAMENTE igual à do modelo treinado\n",
        "X_2024_final = pd.DataFrame(0, index=X_2024_encoded.index, columns=colunas_treino)\n",
        "for col in X_2024_encoded.columns:\n",
        "    if col in X_2024_final.columns:\n",
        "        X_2024_final[col] = X_2024_encoded[col]\n",
        "\n",
        "print(f\"Total de alunos avaliados no ciclo de 2024: {len(X_2024_final)} alunos\")\n",
        "\n",
        "# ============================================================\n",
        "# PREDIÇÕES E AVALIAÇÃO DA PERFORMANCE EM 2024\n",
        "# ============================================================\n",
        "\n",
        "y_pred_2024 = modelo_xgb_carregado.predict(X_2024_final)\n",
        "y_proba_2024 = modelo_xgb_carregado.predict_proba(X_2024_final)[:, 1]\n",
        "\n",
        "# Métricas\n",
        "acc_2024 = accuracy_score(y_2024_real, y_pred_2024)\n",
        "rec_2024 = recall_score(y_2024_real, y_pred_2024)\n",
        "prec_2024 = precision_score(y_2024_real, y_pred_2024)\n",
        "f1_2024 = f1_score(y_2024_real, y_pred_2024)\n",
        "auc_2024 = roc_auc_score(y_2024_real, y_proba_2024)\n",
        "\n",
        "df_metricas_2024 = pd.DataFrame([{\n",
        "    'Amostra Avaliada': 'Ano 2024 (Exclusivo)',\n",
        "    'Total de Alunos': len(df_2024),\n",
        "    'Acurácia': f\"{acc_2024:.4f} ({acc_2024:.2%})\",\n",
        "    'Recall (Em Risco)': f\"{rec_2024:.4f} ({rec_2024:.2%})\",\n",
        "    'Precisão (Em Risco)': f\"{prec_2024:.4f} ({prec_2024:.2%})\",\n",
        "    'F1-Score': f\"{f1_2024:.4f}\",\n",
        "    'ROC-AUC': f\"{auc_2024:.4f}\"\n",
        "}])\n",
        "\n",
        "print(\"\\n\" + \"=\" * 80)\n",
        "print(\"PAINEL DE DESEMPENHO DO MODELO APLICADO À BASE COMPLETA DE 2024\")\n",
        "print(\"=\" * 80)\n",
        "display(df_metricas_2024)\n",
        "\n",
        "# ============================================================\n",
        "# MATRIZ DE CONFUSÃO PARA O ANO DE 2024\n",
        "# ============================================================\n",
        "\n",
        "cm_2024 = confusion_matrix(y_2024_real, y_pred_2024)\n",
        "\n",
        "plt.figure(figsize=(6, 4.2))\n",
        "sns.heatmap(cm_2024, annot=True, fmt='d', cmap='Greens',\n",
        "            xticklabels=['Previsto: Não Risco', 'Previsto: Em Risco'],\n",
        "            yticklabels=['Real: Não Risco', 'Real: Em Risco'])\n",
        "\n",
        "plt.title('Matriz de Confusão — Teste em Lote (Base 2024)', fontsize=11, pad=12, fontweight='bold')\n",
        "plt.ylabel('Classe Real', fontsize=10)\n",
        "plt.xlabel('Classe Predita', fontsize=10)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# AMOSTRA DE ALUNOS COM PROBABILIDADE PREDITA DE RISCO\n",
        "# ============================================================\n",
        "\n",
        "df_resultado_alunos = df_2024[['RA', 'Fase', 'IDA', 'IEG', 'pedra_ano_atual']].copy()\n",
        "df_resultado_alunos['Risco_Real'] = y_2024_real.values\n",
        "df_resultado_alunos['Risco_Predito'] = y_pred_2024\n",
        "df_resultado_alunos['Probabilidade_Risco (%)'] = (y_proba_2024 * 100).round(2)\n",
        "\n",
        "# Classificação da Régua Preventiva\n",
        "def categorizar_regua(prob):\n",
