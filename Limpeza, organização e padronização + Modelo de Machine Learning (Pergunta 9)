        "def ajustar_e_contar_detalhado(df):\n",
        "    \"\"\"\n",
        "    Cria a coluna 'IDA_ajustado' usando a média das notas disponíveis (Mat, Por, Ing)\n",
        "    quando IDA é nulo. Retorna estatísticas detalhadas.\n",
        "    \"\"\"\n",
        "    # Cópia para não modificar o original\n",
        "    df = df.copy()\n",
        "\n",
        "    # Indicadores de quais notas estão disponíveis\n",
        "    tem_mat = df['Mat'].notna()\n",
        "    tem_por = df['Por'].notna()\n",
        "    tem_ing = df['Ing'].notna()\n",
        "\n",
        "    # Número de notas disponíveis por linha (0, 1, 2 ou 3)\n",
        "    n_notas = tem_mat.astype(int) + tem_por.astype(int) + tem_ing.astype(int)\n",
        "\n",
        "    # Média das notas disponíveis (ignora NaN)\n",
        "    media_disponivel = df[['Mat', 'Por', 'Ing']].mean(axis=1, skipna=True)  # NaN se nenhuma nota\n",
        "\n",
        "    # Cria IDA_ajustado: se IDA existe, mantém; senão, usa a média (se houver)\n",
        "    df['IDA_ajustado'] = df['IDA'].where(df['IDA'].notna(), media_disponivel)\n",
        "\n",
        "    # Máscaras para análise\n",
        "    mask_ida_nulo = df['IDA'].isna()\n",
        "    mask_preenchido = mask_ida_nulo & df['IDA_ajustado'].notna()\n",
        "\n",
        "    # Estatísticas básicas\n",
        "    total = len(df)\n",
        "    ida_nao_nulos = (~mask_ida_nulo).sum()\n",
        "    ida_nulos = mask_ida_nulo.sum()\n",
        "    preenchidos = mask_preenchido.sum()\n",
        "    nao_preenchidos = (mask_ida_nulo & df['IDA_ajustado'].isna()).sum()\n",
        "\n",
        "    # Detalhamento por número de notas\n",
        "    n_notas_preenchidos = n_notas[mask_preenchido]\n",
        "    contagem_3 = (n_notas_preenchidos == 3).sum()\n",
        "    contagem_2 = (n_notas_preenchidos == 2).sum()\n",
        "    contagem_1 = (n_notas_preenchidos == 1).sum()\n",
        "\n",
        "    # Detalhar combinações de 2 notas\n",
        "    comb_2 = pd.Series(index=df.index, dtype='object')\n",
        "    comb_1 = pd.Series(index=df.index, dtype='object')\n",
        "\n",
        "    for idx in df.index[mask_preenchido]:\n",
        "        notas = []\n",
        "        if tem_mat.loc[idx]:\n",
        "            notas.append('Mat')\n",
        "        if tem_por.loc[idx]:\n",
        "            notas.append('Por')\n",
        "        if tem_ing.loc[idx]:\n",
        "            notas.append('Ing')\n",
        "        if len(notas) == 2:\n",
        "            comb_2.loc[idx] = '+'.join(notas)\n",
        "        elif len(notas) == 1:\n",
        "            comb_1.loc[idx] = notas[0]\n",
        "\n",
        "    comb_2_counts = comb_2.value_counts().to_dict()\n",
        "    comb_1_counts = comb_1.value_counts().to_dict()\n",
        "\n",
        "    # Monta dicionário de estatísticas\n",
        "    stats = {\n",
        "        'total': total,\n",
        "        'ida_nao_nulos_antes': ida_nao_nulos,\n",
        "        'ida_nulos_antes': ida_nulos,\n",
        "        'preenchidos': preenchidos,\n",
        "        'nao_preenchidos_por_falta_notas': nao_preenchidos,\n",
        "        'preenchidos_com_3_notas': contagem_3,\n",
        "        'preenchidos_com_2_notas': contagem_2,\n",
        "        'preenchidos_com_1_nota': contagem_1,\n",
        "        'detalhe_2_notas': comb_2_counts,\n",
        "        'detalhe_1_nota': comb_1_counts\n",
        "    }\n",
        "\n",
        "    # Exibe o resumo formatado\n",
        "    print(\"=\" * 60)\n",
        "    print(\"RESUMO DO AJUSTE (média das notas disponíveis)\")\n",
        "    print(\"=\" * 60)\n",
        "    print(f\"Total de registros:                    {total}\")\n",
        "    print(f\"IDA não nulos (antes):                 {ida_nao_nulos}\")\n",
        "    print(f\"IDA nulos (antes):                     {ida_nulos}\")\n",
        "    print(\"-\" * 60)\n",
        "    print(f\"Preenchidos (com ≥1 nota):             {preenchidos}\")\n",
        "    print(f\"  - com 3 notas:                       {contagem_3}\")\n",
        "    print(f\"  - com 2 notas:                       {contagem_2}\")\n",
        "    if comb_2_counts:\n",
        "        for comb, cnt in comb_2_counts.items():\n",
        "            print(f\"      {comb}: {cnt}\")\n",
        "    print(f\"  - com 1 nota:                        {contagem_1}\")\n",
        "    if comb_1_counts:\n",
        "        for nota, cnt in comb_1_counts.items():\n",
        "            print(f\"      {nota}: {cnt}\")\n",
        "    print(f\"Não preenchidos (0 notas):             {nao_preenchidos}\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    return df, stats\n",
        "\n",
