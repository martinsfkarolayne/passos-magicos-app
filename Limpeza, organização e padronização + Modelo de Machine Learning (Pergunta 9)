    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.metrics import classification_report, confusion_matrix, recall_score, precision_score, f1_score, roc_auc_score\n",
        "\n",
        "# ============================================================\n",
        "# PREPARAÇÃO DAS FEATURES E VARIÁVEL RESPOSTA\n",
        "# ============================================================\n",
        "\n",
        "# Define a matriz X (features) e o vetor y (target)\n",
        "X = df_ml.drop(columns=['RA', 'ano', 'Em_Risco'])\n",
        "y = df_ml['Em_Risco']\n",
        "\n",
        "# Codificação de variáveis categóricas (Fase, Gênero, Instituição) via One-Hot Encoding\n",
        "X_encoded = pd.get_dummies(X, drop_first=True)\n",
        "\n",
        "# Divisão Treino/Teste (80% treino, 20% teste) com embaralhamento e estratificação\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_encoded, y, test_size=0.20, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "print(\"=\" * 65)\n",
        "print(\"PREPARAÇÃO DOS DADOS DE TREINO E TESTE CONCLUÍDA\")\n",
        "print(\"=\" * 65)\n",
        "print(f\"Registros de Treino: {X_train.shape[0]} amostras\")\n",
        "print(f\"Registros de Teste : {X_test.shape[0]} amostras\")\n",
        "print(f\"Proporção de 'Em Risco' no Treino: {y_train.mean():.2%}\")\n",
        "print(f\"Proporção de 'Em Risco' no Teste : {y_test.mean():.2%}\")\n",
        "\n",
        "# ============================================================\n",
        "# TREINAMENTO E BENCHMARK DOS MODELOS\n",
        "# ============================================================\n",
        "\n",
        "# Instancia os modelos\n",
        "modelos = {\n",
        "    'Regressão Logística': LogisticRegression(max_iter=1000, random_state=42),\n",
        "    'Random Forest': RandomForestClassifier(n_estimators=100, random_state=42),\n",
        "    'XGBoost': XGBClassifier(n_estimators=100, learning_rate=0.1, random_state=42, eval_metric='logloss')\n",
        "}\n",
        "\n",
        "resultados = []\n",
        "\n",
        "# Loop de Treinamento e Avaliação\n",
        "for nome, modelo in modelos.items():\n",
        "    # Treino\n",
        "    modelo.fit(X_train, y_train)\n",
        "\n",
        "    # Predições\n",
        "    y_pred = modelo.predict(X_test)\n",
        "    y_proba = modelo.predict_proba(X_test)[:, 1] if hasattr(modelo, \"predict_proba\") else y_pred\n",
        "\n",
        "    # Métricas focadas na classe 'Em Risco' (1)\n",
        "    rec = recall_score(y_test, y_pred)\n",
        "    prec = precision_score(y_test, y_pred)\n",
        "    f1 = f1_score(y_test, y_pred)\n",
        "    auc = roc_auc_score(y_test, y_proba)\n",
        "\n",
        "    resultados.append({\n",
        "        'Modelo': nome,\n",
        "        'Recall (Em Risco)': rec,\n",
        "        'Precision (Em Risco)': prec,\n",
        "        'F1-Score': f1,\n",
        "        'ROC-AUC': auc\n",
        "    })\n",
        "\n",
        "# Consolidação em DataFrame\n",
        "df_resultados = pd.DataFrame(resultados).sort_values(by='Recall (Em Risco)', ascending=False)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 65)\n",
        "print(\"QUADRO COMPARATIVO DE DESEMPENHO DOS MODELOS\")\n",
        "print(\"=\" * 65)\n",
        "display(df_resultados)\n",
        "\n",
        "# ============================================================\n",
        "# VISUALIZAÇÃO GRÁFICA\n",
        "# ============================================================\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "df_plot = df_resultados.melt(id_vars='Modelo', var_name='Métrica', value_name='Pontuação')\n",
        "\n",
        "sns.barplot(x='Modelo', y='Pontuação', hue='Métrica', data=df_plot, palette='Set2', ax=ax)\n",
        "plt.title('Comparação de Performance dos Modelos de Machine Learning', fontsize=14, pad=15)\n",
        "plt.ylim(0, 1.05)\n",
        "plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "plt.tight_layout()\n",
        "plt.show()"
