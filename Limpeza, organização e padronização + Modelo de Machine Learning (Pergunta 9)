        "def adicionar_inde_ano_atual(dict_dfs, mapeamento=None):\n",
        "    \"\"\"\n",
        "    Adiciona a coluna 'INDE_ano_atual' em cada DataFrame do dicionário.\n",
        "\n",
        "    Parâmetros:\n",
        "    -----------\n",
        "    dict_dfs : dict\n",
        "        Dicionário com os DataFrames (ex: {'df_22': df_22, 'df_23': df_23, ...})\n",
        "    mapeamento : dict, opcional\n",
        "        Dicionário que associa cada chave do dict_dfs ao nome da coluna de origem.\n",
        "        Ex: {'df_22': 'INDE 22', 'df_23': 'INDE 2023', 'df_24': 'INDE 2024'}\n",
        "        Se não fornecido, será usado o mapeamento padrão para os anos 2022, 2023 e 2024.\n",
        "\n",
        "    Retorna:\n",
        "    --------\n",
        "    dict_dfs : dict\n",
        "        O próprio dicionário com os DataFrames modificados in-place.\n",
        "    \"\"\"\n",
        "    # Mapeamento padrão, caso não seja informado\n",
        "    if mapeamento is None:\n",
        "        mapeamento = {\n",
        "            'df_22': 'INDE 22',\n",
        "            'df_23': 'INDE 2023',  # ou 'INDE 23'? Verifique a coluna correta\n",
        "            'df_24': 'INDE 2024'\n",
        "        }\n",
        "\n",
        "    for key, df in dict_dfs.items():\n",
        "        coluna_origem = mapeamento.get(key)\n",
        "        if coluna_origem is None:\n",
        "            print(f\"Aviso: chave '{key}' não encontrada no mapeamento. Pulando...\")\n",
        "            continue\n",
        "\n",
        "        if coluna_origem not in df.columns:\n",
        "            print(f\"Aviso: coluna '{coluna_origem}' não existe no DataFrame '{key}'. Pulando...\")\n",
        "            continue\n",
        "\n",
        "        # Cria a nova coluna copiando os valores (apenas numéricos)\n",
        "        df['INDE_ano_atual'] = df[coluna_origem]\n",
        "\n",
        "        # Opcional: converter para numérico, forçando erros para NaN\n",
        "        df['INDE_ano_atual'] = pd.to_numeric(df[coluna_origem], errors='coerce')\n",
        "\n",
        "        print(f\"Coluna 'INDE_ano_atual' criada em '{key}' a partir de '{coluna_origem}'.\")\n",
        "\n",
        "    return dict_dfs\n",
        "\n",
        "def inclui_campo_pedra_ano_atual(dfs):\n",
        "    for df in dfs.values():\n",
        "        # Usando np.select\n",
        "        condicoes = [\n",
        "            df['INDE_ano_atual'] <= 6.1,\n",
        "            (df['INDE_ano_atual'] > 6.1) & (df['INDE_ano_atual'] <= 7.0),\n",
        "            (df['INDE_ano_atual'] > 7.0) & (df['INDE_ano_atual'] <= 8.0)\n",
        "        ]\n",
        "        valores = ['Quartzo', 'Ágata', 'Ametista']\n",
        "        df['pedra_ano_atual'] = np.select(condicoes, valores, default='Topázio')\n",
        "\n",
        "    return dfs"
      ]
    },
