      "cell_type": "markdown",
      "source": [
        "Na primeira abordagem da modelagem, ao utilizarmos a defasagem escolar histórica como critério para definir os alunos em risco, identificamos uma sobreposição nos dados que gerava um número elevado de falsos alarmes, resultando em 117 alunos erroneamente classificados como vulneráveis. Isso acontecia porque o indicador de defasagem reflete o histórico passado do estudante na rede pública de ensino, penalizando alunos que, embora carregassem um atraso escolar antigo, apresentavam excelente desempenho e alto engajamento nas atividades atuais da Passos Mágicos.\n",
        "\n",
        "Para solucionar essa incoerência e garantir a integridade do aprendizado sem vazamento de dados, redefinimos a variável de risco com foco exclusivo na atuação vigente do estudante dentro do projeto social. Passamos a considerar em risco apenas aqueles que apresentam notas baixas no ciclo atual, engajamento insuficiente ou que estejam na pedra Quartzo, além de removermos o indicador IAN do conjunto de entrada para que os algoritmos aprendessem estritamente a partir do comportamento pedagógico e socioemocional real dos alunos."
      ],
      "metadata": {
        "id": "7WupWNPRxirh"
      },
      "id": "7WupWNPRxirh"
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, recall_score, precision_score,\n",
        "    f1_score, roc_auc_score, confusion_matrix\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# DEFINIÇÃO DA TARGET DE RISCO VIGENTE E SELEÇÃO DE FEATURES\n",
        "# ============================================================\n",
        "\n",
        "# Aluno em risco no ciclo vigente: IDA < 6.0 OU IEG < 6.0 OU Pedra Quartzo\n",
        "df_comum_por_ano['Em_Risco_Vigente'] = np.where(\n",
        "    (df_comum_por_ano['IDA'] < 6.0) |\n",
        "    (df_comum_por_ano['IEG'] < 6.0) |\n",
        "    (df_comum_por_ano['pedra_ano_atual'] == 'Quartzo'),\n",
        "    1,\n",
        "    0\n",
        ")\n",
        "\n",
        "# Seleção de Features limpas (sem Data Leakage e sem IAN)\n",
        "colunas_modelo_definitivo = [\n",
        "    'RA', 'ano',\n",
        "    'Fase', 'Gênero', 'Instituição de ensino',\n",
        "    'IDA', 'IEG', 'IAA', 'IPS', 'IPP', 'IPV', 'Mat', 'Por',\n",
        "    'Em_Risco_Vigente'\n",
        "]\n",
        "\n",
        "df_ml_definitivo = df_comum_por_ano[colunas_modelo_definitivo].copy()\n",
        "\n",
        "# Separando Matriz de Features (X) e Vetor Target (y)\n",
        "X_def = df_ml_definitivo.drop(columns=['RA', 'ano', 'Em_Risco_Vigente'])\n",
        "y_def = df_ml_definitivo['Em_Risco_Vigente']\n",
        "\n",
        "# One-Hot Encoding e Divisão Treino/Teste (80% treino / 20% teste com estratificação)\n",
        "X_def_encoded = pd.get_dummies(X_def, drop_first=True)\n",
        "X_train_d, X_test_d, y_train_d, y_test_d = train_test_split(\n",
        "    X_def_encoded, y_def, test_size=0.20, random_state=42, stratify=y_def\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# TREINAMENTO E AVALIAÇÃO COMPLETA\n",
        "# ============================================================\n",
        "\n",
        "modelos_d = {\n",
        "    'XGBoost': XGBClassifier(n_estimators=100, learning_rate=0.1, random_state=42, eval_metric='logloss'),\n",
        "    'Random Forest': RandomForestClassifier(n_estimators=100, random_state=42),\n",
        "    'Regressão Logística': LogisticRegression(max_iter=1000, random_state=42)\n",
        "}\n",
        "\n",
        "resultados_d = []\n",
        "\n",
        "for nome, modelo in modelos_d.items():\n",
        "    # Treino\n",
        "    modelo.fit(X_train_d, y_train_d)\n",
        "\n",
        "    # Predições\n",
        "    y_pred = modelo.predict(X_test_d)\n",
        "    y_proba = modelo.predict_proba(X_test_d)[:, 1] if hasattr(modelo, \"predict_proba\") else y_pred\n",
        "\n",
        "    # Cálculo das Métricas\n",
        "    resultados_d.append({\n",
        "        'Modelo': nome,\n",
        "        'Acurácia': accuracy_score(y_test_d, y_pred),\n",
        "        'Recall (Em Risco)': recall_score(y_test_d, y_pred),\n",
        "        'Precision (Em Risco)': precision_score(y_test_d, y_pred),\n",
        "        'F1-Score': f1_score(y_test_d, y_pred),\n",
        "        'ROC-AUC': roc_auc_score(y_test_d, y_proba)\n",
        "    })\n",
        "\n",
        "# Consolidação do Quadro Comparativo\n",
        "df_resultados_d = pd.DataFrame(resultados_d).sort_values(by='Acurácia', ascending=False)\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"QUADRO COMPARATIVO DE DESEMPENHO DOS MODELOS (COM ACURÁCIA)\")\n",
        "print(\"=\" * 70)\n",
        "display(df_resultados_d)"
      ],
